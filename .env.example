# MinIO credentials - copy this file to .env and fill in your values
# Never commit the .env file to git!

# MinIO root credentials (used for Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password

# S3/MinIO connection settings for the pipeline
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme_strong_password
S3_BUCKET=bundeswarehouse
S3_REGION=us-east-1

# Bundestag API key (obtain from https://dip.bundestag.de/über-dip/hilfe/api)
BUNDESTAG_API_KEY=your_api_key_here
