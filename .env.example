# MinIO credentials - copy this file to .env and fill in your values

# Anthropic API key (required for RAG Q&A)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# URL of the RAG API server (default shown, matches docker-compose)
RAG_API_URL=http://localhost:8000

# Never commit the .env file to git!

# MinIO root credentials (used for Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password

# S3/MinIO connection settings for the pipeline
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme_strong_password
S3_BUCKET=bundeswarehouse
S3_REGION=us-east-1

# Bundestag API key (obtain from https://dip.bundestag.de/über-dip/hilfe/api)
BUNDESTAG_API_KEY=your_api_key_here

# --- DIP fetch tuning (optional, defaults shown) ---

# HTTP User-Agent sent with every API request.
# Change this if you want to identify your bot or use a custom string.
#DIP_USER_AGENT=bundeswarehouse/1.0 (+https://github.com/test-pls-ignore/bundeswarehouse)

# Seconds to sleep between page requests to avoid triggering rate limits.
# Increase if you observe frequent 429 responses or challenge-page blocks.
#DIP_REQUEST_DELAY=0.5

# Maximum number of retry attempts for transient 429/5xx responses.
#DIP_MAX_RETRIES=3

# Maximum backoff duration (seconds) between retry attempts.
# Actual backoff is capped at this value using exponential backoff with jitter.
#DIP_RETRY_BACKOFF_MAX=60
