FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Bake the vss extension into the image at build time: the running
# containers (mcp, rag) are bound to 127.0.0.1 only and can't reach
# extensions.duckdb.org at runtime, so a bare `LOAD vss` there fails with
# "vss.duckdb_extension not found" unless it was already cached here.
RUN python -c "import duckdb; duckdb.connect().execute('INSTALL vss')"
COPY analytics/ analytics/
CMD ["uvicorn", "analytics.server:app", "--host", "0.0.0.0", "--port", "8000"]
