generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"

}

model Vorgang {
  id              String   @id
  wahlperiode     Int?
  titel           String?
  datum           DateTime?
  typ             String?
  vorgangstyp     String?
  aktueller_stand String?
  inhalt          String?
  metadata_json   String? 
  created_at      DateTime @default(now())
  updated_at      DateTime? @updatedAt

  dokumente       Dokument[]
  aktivitaeten    Aktivitaet[]

  @@index([titel])
  @@map("vorgaenge")
}

model Dokument {
  id              String   @id
  vorgang_id      String?
  drucksachetyp   String?
  nummer          String?
  datum           DateTime?
  titel           String?
  autoren         String?
  pdf_url         String?
  text_content    String?
  metadata_json   String?
  created_at      DateTime @default(now())

  vorgang         Vorgang? @relation(fields: [vorgang_id], references: [id])

  @@index([titel])
  @@index([vorgang_id])
  @@map("dokumente")
}

model Aktivitaet {
  id              String   @id
  vorgang_id      String?
  datum           DateTime?
  person          String?
  art             String?
  titel           String?
  metadata_json   String?
  created_at      DateTime @default(now())

  vorgang         Vorgang? @relation(fields: [vorgang_id], references: [id])

  @@index([titel])
  @@index([vorgang_id])
  @@map("aktivitaeten")
}
